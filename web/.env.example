# Laravel API base URL, as reachable from this Next.js server. Never exposed to browsers.
API_URL=http://127.0.0.1:8000

# Public origin of this web app. Mutating requests from any other origin are rejected (CSRF defense).
APP_ORIGIN=http://localhost:3000

# How many trusted reverse proxies (load balancer, CDN) sit in front of this server and append to
# X-Forwarded-For. Production behind one load balancer: 1. Must be accurate, or clients can spoof IPs.
TRUSTED_PROXY_HOPS=0

# Space-separated origins that serve media images to browsers: the API's public URL (APP_URL in the
# backend) for local storage, or your S3/R2/CDN origin in production.
MEDIA_ORIGINS=http://localhost:8000

NEXT_PUBLIC_APP_NAME=Ummah
