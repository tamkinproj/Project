APP_NAME=Ummah
APP_ENV=local
# Generate with: php artisan key:generate  (encrypts private profile fields — back it up, never commit it)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public URL of the web app — used in email links (verification, password reset)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Comma-separated IPs/CIDRs of reverse proxies (load balancer, the Next.js server) allowed to set X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1

# Comma-separated browser origins allowed to call the API directly. Empty = none
# (the web app talks to the API server-to-server, mobile apps are not browsers).
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ecosystem
DB_USERNAME=ecosystem
DB_PASSWORD=ecosystem

SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sessions (API tokens) expire after this many minutes of existence. 43200 = 30 days.
AUTH_TOKEN_TTL_MINUTES=43200

# Secret HMAC key for card chip UIDs and activation codes. 32+ random bytes, base64.
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Rotating it invalidates all stored card hashes — plan a re-enrollment before rotating.
CARD_HMAC_KEY=

# Uploaded media (avatars, post images). "media" = local private disk; use "media-s3" in production.
MEDIA_DISK=media
MEDIA_URL_TTL_MINUTES=60

# Mail: Mailpit from docker-compose catches everything locally at http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
